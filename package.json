{
  "name": "maengelwerk-probe-ipa",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:client\" \"npm:dev:server\"",
    "dev:client": "vite",
    "dev:server": "tsx watch backend/server.ts",
    "build": "npm run check && vite build",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "preview": "vite preview",
    "copy-sdx-assets": "node scripts/copy-sdx-assets.mjs",
    "postinstall": "npm run copy-sdx-assets"
  },
  "dependencies": {
    "@swisscom/sdx": "latest",
    "express": "^5.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "concurrently": "^9.2.0",
    "tsx": "^4.20.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.5"
  }
}
